+// pipeline-data-checked: "Last checked" follows the checker (road.json updatedAt, cached by useRoad), never a hand-edited constant.
+function dataCheckedLabel() {
+  let at = null; try { const d = JSON.parse(localStorage.getItem(ROAD_CACHE_KEY)); at = d && d.updatedAt; } catch {}
+  if (at && !Number.isNaN(Date.parse(at))) return `${ukStamp(at, false)} · ${feedTime(at)}`;
+  return fmtDay(String(DATA_CHECKED).replace(new RegExp(" " + new Date().getFullYear() + "$"), ""));
+}
